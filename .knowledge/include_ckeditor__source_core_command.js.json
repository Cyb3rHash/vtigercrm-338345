{"is_source_file": true, "format": "JavaScript", "description": "This file defines the CKEDITOR.command class, which is responsible for creating command objects within the CKEditor rich text editor. It includes methods for executing commands, changing their state, enabling/disabling them, and toggling their state. The class extends event capabilities and handles user interactions and command state management within the editor environment.", "external_files": ["LICENSE.html", "http://ckeditor.com/license"], "external_methods": ["CKEDITOR.tools.extend", "CKEDITOR.event.call", "CKEDITOR.event.implementOn"], "published": ["CKEDITOR.command"], "classes": [{"name": "CKEDITOR.command", "description": "Represents a command within CKEditor, encapsulating execution logic, state management, and interaction with the editor instance."}], "methods": [{"name": "exec( data )", "description": "Executes the command with provided data, focusing the editor if required, and invoking the command's execution logic.", "scope": "CKEDITOR.command", "scopeKind": "class"}, {"name": "enable()", "description": "Sets the command's state to enabled if it was disabled.", "scope": "CKEDITOR.command", "scopeKind": "class"}, {"name": "disable()", "description": "Disables the command.", "scope": "CKEDITOR.command", "scopeKind": "class"}, {"name": "setState( newState )", "description": "Changes the command's state to a new state and fires a 'state' event, returning whether the state changed.", "scope": "CKEDITOR.command", "scopeKind": "class"}, {"name": "toggleState()", "description": "Switches the command's state between ON and OFF.", "scope": "CKEDITOR.command", "scopeKind": "class"}], "calls": ["CKEDITOR.tools.extend", "CKEDITOR.event.call", "CKEDITOR.event.implementOn"], "search-terms": ["CKEDITOR.command", "command execution", "command state management", "CKEditor commands", "command class"], "state": 2, "file_id": 2269, "knowledge_revision": 7949, "git_revision": "410982386233066077570ef9d63b8642a